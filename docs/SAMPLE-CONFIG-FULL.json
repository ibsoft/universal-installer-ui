{
  "meta": {
    "name": "Universal Installer MVP",
    "version": "1.2.3",
    "publisher": "Your Company Ltd.",
    "eulaPath": "assets\\EULA.txt",
    "supportUrl": "https://support.example.com",
    "productCode": "{00000000-0000-0000-0000-000000000000}"
  },

  "ui": {
    "logoPath": "assets\\brand.png",
    "iconPath": "assets\\App.ico",
    "title": "Universal Installer MVP",
    "subtitle": "Setup Wizard",
    "theme": {
      "mode": "dark",
      "primaryColor": "#22C55E",
      "fontSize": 10
    },
    "locale": "en-US",
    "window": { "width": 920, "height": 600, "topMost": false },
    "showTaskProgress": true
  },

  "security": {
    "requireAdmin": true,
    "validateChecksums": true,
    "validateCodeSigning": false,
    "secureTemp": true
  },

  "artifacts": [
    {
      "id": "appMsi",
      "type": "msi",
      "source": "https://cdn.example.com/downloads/MyApp_1.2.3_x64.msi",
      "sha256": "<msi_sha256_here>",
      "silentArgs": "/qn /norestart",
      "transform": "",
      "properties": { "INSTALLDIR": "C:\\Program Files\\MyApp" }
    },
    {
      "id": "svcZip",
      "type": "zip",
      "source": "files\\service.zip",
      "sha256": "<zip_sha256_here>",
      "targetDir": "%ProgramFiles%\\MyService"
    },
    {
      "id": "helperExe",
      "type": "exe",
      "source": "https://cdn.example.com/tools/helper-setup.exe",
      "sha256": "<exe_sha256_here>",
      "silentArgs": "/S",
      "workingDir": "%TEMP%"
    },
    {
      "id": "staticFiles",
      "type": "copy",
      "source": "files\\static",
      "targetDir": "%ProgramData%\\MyApp\\static",
      "overwrite": true
    },
    {
      "id": "msixPkg",
      "type": "msix",
      "source": "files\\app.msix",
      "sha256": "<msix_sha256_here>"
    }
  ],

  "preChecks": [
    { "type": "adminRights", "failMessage": "Run as Administrator." },
    { "type": "osVersion", "min": "10.0.19041" },
    { "type": "dotnetDesktopRuntime", "min": "8.0.0" },
    { "type": "diskSpace", "drive": "C:", "minMB": 2048 },
    { "type": "portsFree", "ports": [8080, 443] },
    { "type": "filesUnlocked", "paths": ["%ProgramFiles%\\MyService\\MySvc.exe"] }
  ],

  "scripts": {
    "pre": [
      {
        "type": "powershell",
        "script": "scripts\\precheck.ps1",
        "args": "-Verbose",
        "timeoutSec": 300,
        "continueOnError": false
      },
      {
        "type": "cmd",
        "script": "scripts\\prep.bat",
        "args": "/quiet",
        "timeoutSec": 120,
        "continueOnError": true
      }
    ],
    "post": []
  },

  "tasks": [
    { "type": "runArtifact", "ref": "appMsi", "continueOnError": false },

    { "type": "runArtifact", "ref": "helperExe", "continueOnError": true },

    { "type": "unzip", "ref": "svcZip", "continueOnError": false },

    {
      "type": "serviceInstall",
      "name": "MyCompany.MyService",
      "displayName": "My Company Background Service",
      "description": "Performs background processing.",
      "binaryPath": "%ProgramFiles%\\MyService\\MyService.exe",
      "startMode": "Automatic",
      "delayedAutoStart": true,
      "account": "LocalSystem",
      "alwaysOn": false
    },
    { "type": "serviceStart", "name": "MyCompany.MyService" },

    {
      "type": "registrySet",
      "path": "HKLM\\Software\\MyCompany\\MyApp",
      "name": "ApiBaseUrl",
      "value": "https://api.example.com",
      "kind": "String"
    },
    {
      "type": "registrySet",
      "path": "HKLM\\Software\\MyCompany\\MyApp",
      "name": "EnableTelemetry",
      "value": 1,
      "kind": "DWord"
    },

    { "type": "envSet", "name": "MYAPP_HOME", "value": "%ProgramFiles%\\MyApp", "target": "Machine" },

    { "type": "copy", "source": "files\\configs", "target": "%ProgramData%\\MyApp\\configs", "recursive": true, "overwrite": true },

    { "type": "removeFile", "path": "%ProgramData%\\MyApp\\temp\\obsolete.json", "continueOnError": true },

    { "type": "shortcut", "target": "%ProgramFiles%\\MyApp\\MyApp.exe", "location": "Desktop", "name": "MyApp", "icon": "assets\\app.ico", "arguments": "" },
    { "type": "shortcut", "target": "%ProgramFiles%\\MyApp\\MyApp.exe", "location": "StartMenu", "name": "MyApp", "icon": "assets\\app.ico", "arguments": "" }
  ],

  "postTasks": [
    {
      "type": "powershell",
      "script": "scripts\\post.ps1",
      "args": "-RepairFalse",
      "timeoutSec": 300,
      "continueOnError": true
    }
  ],

  "uninstall": {
    "preTasks": [
      { "type": "serviceStop", "name": "MyCompany.MyService", "continueOnError": true }
    ],
    "tasks": [
      { "type": "serviceDelete", "name": "MyCompany.MyService", "continueOnError": true },
      { "type": "msiUninstall", "productCode": "{00000000-0000-0000-0000-000000000000}", "quietArgs": "/qn /norestart" },
      { "type": "removeDir", "path": "%ProgramFiles%\\MyService", "recursive": true, "continueOnError": true },
      { "type": "removeDir", "path": "%ProgramData%\\MyApp", "recursive": true, "continueOnError": true },
      { "type": "registryDelete", "path": "HKLM\\Software\\MyCompany\\MyApp", "continueOnError": true },
      { "type": "envUnset", "name": "MYAPP_HOME", "target": "Machine", "continueOnError": true },
      { "type": "shortcutDelete", "location": "Desktop", "name": "MyApp", "continueOnError": true },
      { "type": "shortcutDelete", "location": "StartMenu", "name": "MyApp", "continueOnError": true }
    ]
  },

  "logging": {
    "level": "Info",
    "file": "C:\\ProgramData\\UniversalInstaller\\logs\\install.log",
    "maxSizeMB": 10,
    "maxFiles": 5,
    "console": true
  },

  "telemetry": {
    "enabled": false,
    "endpoint": "",
    "headers": {}
  }
}
